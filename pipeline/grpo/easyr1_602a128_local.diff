--- a/verl/__init__.py
+++ b/verl/__init__.py
@@ -30,3 +30,19 @@ if os.getenv("USE_MODELSCOPE_HUB", "0").lower() in ["true", "y", "1"]:
         raise ImportError("You are using the modelscope hub, please install modelscope by `pip install modelscope`.")
 
     patch_hub()
+
+
+# --- caption GRPO multi-turn patch (strict: env-selected code dir) ---
+import os as _os
+_code_dir = _os.environ.get("CAPTION_GRPO_CODE")
+if _code_dir is None:
+    raise RuntimeError("CAPTION_GRPO_CODE is not set; refusing to fall back (protocol separation)")
+import sys as _sys
+if _code_dir not in _sys.path:
+    _sys.path.insert(0, _code_dir)
+try:
+    import easyr1_caption as _ec
+    _ec.install()
+    print("[caption patch] installed from", _ec.__file__, "| proto =", _ec.proto.__name__, flush=True)
+except Exception as _e:
+    raise RuntimeError(f"[caption patch] FAILED to install from {_code_dir}: {_e}") from _e
